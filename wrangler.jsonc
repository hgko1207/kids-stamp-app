{
  // 정적 자산만 올리는 Worker. 서버 코드는 없다(2026-11-16 Vercel에서 옮김)
  "name": "kids-stamp-app",
  "compatibility_date": "2026-11-13",
  // 커스텀 도메인. DNS 레코드와 인증서는 배포할 때 Cloudflare가 만든다
  "routes": [{ "pattern": "stamp.hgko.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // 라우터 없는 한 화면 앱이라 없는 주소도 index.html로 연다
    "not_found_handling": "single-page-application"
  }
}
